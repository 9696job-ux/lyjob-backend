# ─── SERVIDOR ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://lyjob.com

# ─── BASE DE DATOS MySQL (cPanel) ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lyjob_db
DB_USER=lyjob_user
DB_PASSWORD=TU_PASSWORD_AQUI

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_SEGURA_DE_64_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORREO (cPanel SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=mail.lyjob.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@lyjob.com
SMTP_PASS=TU_PASSWORD_CORREO
EMAIL_FROM_NAME=Lyjob
EMAIL_FROM=no-reply@lyjob.com

# ─── PAYPHONE ────────────────────────────────────────────────────────────────
PAYPHONE_TOKEN=TU_TOKEN_PAYPHONE
PAYPHONE_STORE_ID=TU_STORE_ID

# ─── SERVIDOR SRI (DigitalOcean externo - se mantiene) ───────────────────────
SRI_SERVER_URL=http://104.131.106.16:3000

# ─── SEGURIDAD ───────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
